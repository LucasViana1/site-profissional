# Copie para .env e ajuste. Em produção, defina as mesmas variáveis na Vercel.
# O valor é lido no build (`pnpm build`), não em tempo de execução.
# Variável ausente ou diferente de "true" mantém o conteúdo oculto.

# Seção de projetos, na página e na navegação.
NEXT_PUBLIC_SHOW_PROJECTS=false

# Seção de estudos & escrita, na página e na navegação.
NEXT_PUBLIC_SHOW_WRITING=false

# Bloco de IA dentro da seção de stack.
NEXT_PUBLIC_SHOW_AI_STACK=true
